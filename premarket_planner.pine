//@version=5
indicator(title="QQQ Premarket Planner", shorttitle="PreMkt Planner",
          overlay=true, max_boxes_count=10, max_labels_count=20)

// ── Inputs ────────────────────────────────────────────────────────────────────
upside_level   = input.float(title="Upside Level",   defval=0.0, step=0.25)
downside_level = input.float(title="Downside Level", defval=0.0, step=0.25)
zone_height    = input.float(title="Zone Height",    defval=0.5, step=0.25, minval=0.01)

// ── Zone boundaries ───────────────────────────────────────────────────────────
up_top   = upside_level   + zone_height / 2
up_bot   = upside_level   - zone_height / 2
down_top = downside_level + zone_height / 2
down_bot = downside_level - zone_height / 2

// ── Draw zones once on the first bar, extend to the right ─────────────────────
var box up_box   = na
var box down_box = na

if barstate.isfirst
    up_box   := box.new(bar_index, up_top,   bar_index + 1, up_bot,
                        border_color=color.green, bgcolor=color.new(color.green, 85),
                        extend=extend.right)
    down_box := box.new(bar_index, down_top, bar_index + 1, down_bot,
                        border_color=color.red,   bgcolor=color.new(color.red,   85),
                        extend=extend.right)

// ── Sticky labels (redrawn each bar to stay at current bar) ───────────────────
var label up_lbl   = na
var label down_lbl = na

label.delete(up_lbl)
label.delete(down_lbl)

bullish = close >= upside_level
bearish = close <= downside_level

up_lbl := label.new(
     x        = bar_index,
     y        = up_top,
     text     = "Upside " + str.tostring(upside_level) + (bullish ? " ▲ CALL BIAS" : ""),
     style    = label.style_label_down,
     color    = color.new(color.green, 70),
     textcolor= color.white,
     size     = size.small)

down_lbl := label.new(
     x        = bar_index,
     y        = down_bot,
     text     = "Downside " + str.tostring(downside_level) + (bearish ? " ▼ PUT BIAS" : ""),
     style    = label.style_label_up,
     color    = color.new(color.red, 70),
     textcolor= color.white,
     size     = size.small)
